# Copiar a `.env` y ajustar valores:  cp .env.example .env
# Ningun secreto debe versionarse: `.env` esta en .gitignore.

# --- Servicio ---
NODE_ENV=development
PORT=4001
LOG_LEVEL=debug
APP_NAME=Mi App
APP_URL=http://localhost:3000
APP_ICON=https://i.ibb.co/Kyp2m0t/cover.png

# --- RabbitMQ (ver docker-compose.yml) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- SMTP (canal email). Para desarrollo: https://ethereal.email ---
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SENDER_EMAIL=
SENDER_EMAIL_PASSWORD=

# --- Fiabilidad ---
# Reintentos por mensaje (puede sobreescribirse por mensaje con "maxRetries").
MAX_RETRIES=3
# Espera entre reintentos (ms). Se implementa con colas de reintento con TTL.
RETRY_DELAY_MS=30000
# Mensajes en vuelo por consumidor.
PREFETCH_COUNT=10
# Timeout de entrega del canal webhook (ms).
WEBHOOK_TIMEOUT_MS=10000
# Tiempo que se recuerda un id ya procesado para deduplicar (ms).
IDEMPOTENCY_TTL_MS=86400000

# --- Elasticsearch (opcional, solo para centralizar logs) ---
ELASTICSEARCH_ENABLED=0
ELASTICSEARCH_URL=http://localhost:9200

# --- APM elastico (opcional) ---
ENABLE_APM=0
ELASTIC_APM_SERVER_URL=http://localhost:8200
ELASTIC_APM_SECRET_TOKEN=
